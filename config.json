# ============================================================
# ENVIRONMENT VARIABLE HELPER
# ============================================================

def _env(
    *names,
    required=False
):

    for name in names:

        value = os.environ.get(
            name
        )

        if value is not None:

            value = value.strip()

            if value:
                return value

    if required:

        raise RuntimeError(
            "Missing required GitHub Secret/environment "
            f"variable. Tried: {', '.join(names)}"
        )

    return None


# ============================================================
# SECRETS
# ============================================================

def secret_config():

    # --------------------------------------------------------
    # GEMINI
    # --------------------------------------------------------

    gemini_api_key = _env(
        "GEMINI_API_KEY",
        "GOOGLE_GEMINI_API_KEY",
        "GOOGLE_API_KEY",
        required=True
    )

    # --------------------------------------------------------
    # YOUTUBE
    # --------------------------------------------------------

    youtube_client_id = _env(
        "YOUTUBE_CLIENT_ID",
        required=True
    )

    youtube_client_secret = _env(
        "YOUTUBE_CLIENT_SECRET",
        required=True
    )

    youtube_refresh_token = _env(
        "YOUTUBE_REFRESH_TOKEN",
        required=True
    )

    # --------------------------------------------------------
    # GOOGLE DRIVE
    #
    # Supported formats:
    #
    # 1. GOOGLE_DRIVE_CREDENTIALS
    #    Complete service-account JSON.
    #
    # 2. GOOGLE_DRIVE_CREDENTIALS_JSON
    #    Same thing under another common name.
    #
    # 3. GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON
    #
    # The code also supports a mounted credentials file.
    # --------------------------------------------------------

    google_drive_credentials = _env(
        "GOOGLE_DRIVE_CREDENTIALS",
        "GOOGLE_DRIVE_CREDENTIALS_JSON",
        "GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON",
        required=True
    )

    # --------------------------------------------------------
    # OPTIONAL DRIVE ID
    # --------------------------------------------------------

    google_drive_folder_id = _env(
        "GOOGLE_DRIVE_FOLDER_ID",
        "DRIVE_FOLDER_ID"
    )

    # --------------------------------------------------------
    # OPTIONAL YOUTUBE CHANNEL
    # --------------------------------------------------------

    youtube_channel_id = _env(
        "YOUTUBE_CHANNEL_ID"
    )

    return {
        "gemini_api_key": gemini_api_key,

        "youtube_client_id":
            youtube_client_id,

        "youtube_client_secret":
            youtube_client_secret,

        "youtube_refresh_token":
            youtube_refresh_token,

        "google_drive_credentials":
            google_drive_credentials,

        "google_drive_folder_id":
            google_drive_folder_id,

        "youtube_channel_id":
            youtube_channel_id
    }


# ============================================================
# VALIDATE CONFIGURATION
# ============================================================

def validate_config():

    if int(
        CONFIG[
            "chapter_count"
        ]
    ) != 12:

        raise RuntimeError(
            "chapter_count must be exactly 12."
        )

    if int(
        CONFIG[
            "script_minutes_min"
        ]
    ) <= 0:

        raise RuntimeError(
            "script_minutes_min must be greater than zero."
        )

    if int(
        CONFIG[
            "script_minutes_max"
        ]
    ) < int(
        CONFIG[
            "script_minutes_min"
        ]
    ):

        raise RuntimeError(
            "script_minutes_max cannot be less than "
            "script_minutes_min."
        )

    if int(
        CONFIG[
            "words_per_minute_min"
        ]
    ) <= 0:

        raise RuntimeError(
            "words_per_minute_min must be greater than zero."
        )

    if int(
        CONFIG[
            "words_per_minute_max"
        ]
    ) < int(
        CONFIG[
            "words_per_minute_min"
        ]
    ):

        raise RuntimeError(
            "words_per_minute_max cannot be less than "
            "words_per_minute_min."
        )

    if int(
        CONFIG[
            "retry_count"
        ]
    ) < 1:

        raise RuntimeError(
            "retry_count must be at least 1."
        )

    if float(
        CONFIG[
            "retry_delay_min"
        ]
    ) < 0:

        raise RuntimeError(
            "retry_delay_min cannot be negative."
        )

    if float(
        CONFIG[
            "retry_delay_max"
        ]
    ) < float(
        CONFIG[
            "retry_delay_min"
        ]
    ):

        raise RuntimeError(
            "retry_delay_max cannot be less than "
            "retry_delay_min."
        )

    models = CONFIG.get(
        "models",
        {}
    )

    if not models.get(
        "script"
    ):

        raise RuntimeError(
            "At least one Gemini script model is required."
        )

    return True


validate_config()
